# Settings for compose.yaml and the steps. Copy this file to .env before step 1:
#
#   cp .env.example .env
#
# The password of the demo database. The steps pass it to the agent inside the source URL,
# encoded for it.
POSTGRES_PASSWORD=jaffle

# The port on 127.0.0.1 where the source database listens. Change it when another
# program on this machine already uses 15432.
SOURCE_PORT=15432

# The user and group the DuckDB container runs as. The steps set both to yours.
# When you run docker compose yourself on Linux, set them to the output of id -u and id -g.
# HOST_UID=1000
# HOST_GID=1000
