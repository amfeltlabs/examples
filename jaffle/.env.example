# Settings for compose.yaml and the steps. Copy this file to .env before step 1:
#
#   cp .env.example .env
#
# The agent image, pinned by its registry digest. This line is the only one to change to
# run another build of the agent. project/IMAGE names the image the ready-made project
# was made with; keep the two in step.
AGENT_IMAGE=ghcr.io/infusal/agent-quickstart:v4.24.0@sha256:6ca4d02403f09f4b002b8087e919576dbb1e5a229d8e07aa9b5fe4e563e2c174

# The password of the demo database. Only this machine can reach it; the steps pass it to
# the agent inside the source URL.
POSTGRES_PASSWORD=jaffle

# The port on 127.0.0.1 where your own SQL client can reach the source database, as user
# jaffle, database jaffle. The steps do not use it.
SOURCE_PORT=55432

# The user and group the agent and DuckDB containers run as. The steps set both to yours.
# When you run docker compose yourself on Linux, set them to the output of id -u and id -g.
# HOST_UID=1000
# HOST_GID=1000
