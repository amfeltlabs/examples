# Optional settings for compose.yaml. It needs no settings file: these are its defaults.
# To change one, copy this file to .env first:
#
#   cp .env.example .env
#
# The password of the demo database.
POSTGRES_PASSWORD=jaffle

# The port on 127.0.0.1 where the source database listens. Change it when another
# program on this machine already uses 15432.
SOURCE_PORT=15432
